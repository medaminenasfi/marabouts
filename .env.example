# =============================================================================
# Marabouts – Environment variables (LOCAL DEV only)
# =============================================================================
# For VPS production: use docker-compose.prod.yml instead (no .env needed).
#   cp docker-compose.prod.example.yml docker-compose.prod.yml
#   nano docker-compose.prod.yml
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=marabouts
POSTGRES_PASSWORD=marabouts_secret
POSTGRES_DB=marabouts_db
# Only used with docker-compose.dev.yml (local psql access). VPS: leave unset.
# POSTGRES_HOST_PORT=5436

# ── pgAdmin (optional – use profile "tools" on VPS) ───────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@marabouts.local
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:6001

# ── Frontend ──────────────────────────────────────────────────────────────────
# IMPORTANT: NEXT_PUBLIC_API_URL is baked into the frontend at BUILD time.
# Rebuild frontend after changing: docker compose up --build frontend -d
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=6001

# VPS production → see docker-compose.prod.example.yml (no .env needed)

# Optional (used in contact page)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
